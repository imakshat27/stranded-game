# ==============================================================================
# STRANDED Backend - Environment Configuration
# ==============================================================================

ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://stranded-game.vercel.app

# Database: SQLite for local dev, or Neon / PostgreSQL for cloud
# Local SQLite:
DATABASE_URL=sqlite:///./stranded.db
# Neon Serverless PostgreSQL:
# DATABASE_URL=postgresql://<user>:<password>@<ep-xyz>.neon.tech/stranded?sslmode=require

# AI Search Configuration Defaults
SEARCH_MAX_NODES=5000
SEARCH_MAX_DEPTH=30
SEARCH_TIMEOUT_MS=2500
