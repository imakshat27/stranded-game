# ==============================================================================
# STRANDED Backend - Environment Configuration
# ==============================================================================

ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://stranded-game.vercel.app

# Database: SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite:///./stranded.db

# AI Search Configuration Defaults
SEARCH_MAX_NODES=5000
SEARCH_MAX_DEPTH=30
SEARCH_TIMEOUT_MS=2500
