# ==============================================================================
# STRANDED - Environment Configuration Template
# Copy this file to .env or place corresponding variables in backend/.env and frontend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS settings: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://stranded-game.vercel.app

# Database: SQLite for local dev, PostgreSQL for production (Render / Supabase / Neon)
DATABASE_URL=sqlite:///./stranded.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@hostname:5432/stranded_db

# AI Search Configuration Defaults
SEARCH_MAX_NODES=5000
SEARCH_MAX_DEPTH=30
SEARCH_TIMEOUT_MS=2500

# ------------------------------------------------------------------------------
# Frontend Settings (Prefix with VITE_ for Vite bundling)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_APP_NAME="STRANDED: AI Survival Strategy"
VITE_ENABLE_ANALYTICS=true
